# 只有变量名和无敏感性的说明 —— **这个文件进版本库,.env 不进**(规格 §17.3)。
# 价格和实际模型 ID 在受控后台配置,**不塞进浏览器环境变量**(§17.5)。

APP_ENV=development              # development / test / production
DATABASE_URL=                    # 例:postgresql+psycopg://用户@localhost:5432/aimc_dev
REDIS_URL=                       # 例:redis://localhost:6379/0
OBJECT_STORE_KIND=filesystem     # filesystem | s3(本机默认 filesystem,见 README 偏离说明)
OBJECT_STORE_ROOT=               # filesystem 时的根目录;绝不放在版本库里
OBJECT_STORE_ENDPOINT=           # s3 时的端点
OBJECT_STORE_BUCKET=
AUTH_MODE=dev                    # dev | oidc。**生产启动时必须拒绝 dev**(§17.4 第 3 步)
OIDC_ISSUER=
OIDC_CLIENT_ID=
SECRET_MANAGER_KIND=             # 密钥只存引用;本地开发可用文件后端,不提交
ALLOWED_MODEL_ENDPOINTS=         # 逗号分隔的白名单;不在名单上的端点一律拒
TRACE_RETENTION_DAYS=            # Trace 保留策略;留空表示未定,不要默认成 0
WORKER_CONCURRENCY=
TRAINING_ADAPTER=mock            # mock | selfhosted | managed。**mock 的产物不许计入真实评测**
