{
  "说明": [
    "条件操作符的**人工预期表**(规格附录 C.2「类型与空值」那一行,判定方式=固定预期表)。",
    "这张表是**手写的**,不是从实现跑出来的 —— 从实现跑出来的期望值,实现错了期望值跟着一起错。",
    "特殊值用标记写,因为 JSON 表达不了它们:",
    "  {\"$\": \"缺失\"} = 字段根本不存在(和 null 不是一回事)",
    "期望值里的 \"变量缺失\" / \"类型不匹配\" 表示**应该抛这个异常**,不是返回 false。"
  ],
  "四态必须分开": [
    {"操作符": "exists",          "左": {"$": "缺失"}, "期望": false, "为什么": "字段不存在"},
    {"操作符": "exists",          "左": null,          "期望": true,  "为什么": "值是 null,但字段在"},
    {"操作符": "exists",          "左": 0,             "期望": true,  "为什么": "0 是个值"},
    {"操作符": "exists",          "左": "",            "期望": true,  "为什么": "空字符串是个值"},
    {"操作符": "not_exists",      "左": {"$": "缺失"}, "期望": true},
    {"操作符": "not_exists",      "左": null,          "期望": false, "为什么": "别把 null 当「不存在」"},
    {"操作符": "is_null",         "左": null,          "期望": true},
    {"操作符": "is_null",         "左": 0,             "期望": false, "为什么": "0 不是 null"},
    {"操作符": "is_null",         "左": "",            "期望": false, "为什么": "空串不是 null"},
    {"操作符": "is_null",         "左": [],            "期望": false, "为什么": "空列表不是 null"},
    {"操作符": "is_null",         "左": false,         "期望": false, "为什么": "false 不是 null"},
    {"操作符": "is_null",         "左": {"$": "缺失"}, "期望": "变量缺失",
      "为什么": "**「没这个字段」和「值是 null」处置相反**:前者是绑定写错了,后者是数据"},
    {"操作符": "is_not_null",     "左": 0,             "期望": true},
    {"操作符": "is_empty_string", "左": "",            "期望": true},
    {"操作符": "is_empty_string", "左": " ",           "期望": false, "为什么": "一个空格不是空串"},
    {"操作符": "is_empty_string", "左": [],            "期望": "类型不匹配",
      "为什么": "**空列表用 length_eq 0 判**,不共用「空」这个词(§6.3)"},
    {"操作符": "is_empty_string", "左": null,          "期望": "类型不匹配"},
    {"操作符": "is_empty_string", "左": 0,             "期望": "类型不匹配"}
  ],
  "不隐式转换": [
    {"操作符": "equals", "左": 1,      "右": 1,      "期望": true},
    {"操作符": "equals", "左": 1,      "右": "1",    "期望": "类型不匹配",
      "为什么": "数字 1 和文本 \"1\" 不相等,而且**不隐式转换**;要比就插显式转换节点"},
    {"操作符": "equals", "左": "1",    "右": 1,      "期望": "类型不匹配"},
    {"操作符": "equals", "左": 1,      "右": 1.0,    "期望": true,
      "为什么": "int 和 float 都是数字 —— 这一条是**对照**:不是「类型名不同就抛」"},
    {"操作符": "equals", "左": 0,      "右": "",     "期望": "类型不匹配", "为什么": "0 和空串不是一回事"},
    {"操作符": "equals", "左": 0,      "右": false,  "期望": "类型不匹配",
      "为什么": "Python 里 0 == False 是 True —— 这一条挡的就是那个"},
    {"操作符": "equals", "左": "甲",   "右": "甲",   "期望": true},
    {"操作符": "not_equals", "左": "甲", "右": "乙", "期望": true},
    {"操作符": "equals", "左": {"$": "缺失"}, "右": 1, "期望": "变量缺失",
      "为什么": "**缺变量抛,不默认 false** —— 默认 false 会把配置错误静默带去 ELSE 分支"}
  ],
  "布尔不是数字": [
    {"操作符": "gt",  "左": 3,     "右": 2,     "期望": true},
    {"操作符": "gt",  "左": 2,     "右": 3,     "期望": false},
    {"操作符": "gte", "左": 2,     "右": 2,     "期望": true},
    {"操作符": "lt",  "左": 2.5,   "右": 3,     "期望": true},
    {"操作符": "gt",  "左": true,  "右": 0,     "期望": "类型不匹配",
      "为什么": "**Python 里 True > 0 成立** —— 一个开关字段会悄悄通过数值比较"},
    {"操作符": "lte", "左": 1,     "右": false, "期望": "类型不匹配"},
    {"操作符": "gt",  "左": "10",  "右": 9,     "期望": "类型不匹配", "为什么": "文本数字不自动转"},
    {"操作符": "gt",  "左": null,  "右": 0,     "期望": "类型不匹配"}
  ],
  "长度规则": [
    {"操作符": "length_eq", "左": [],            "右": 0, "期望": true,  "为什么": "**空列表就这么判**"},
    {"操作符": "length_eq", "左": [1, 2],        "右": 2, "期望": true},
    {"操作符": "length_gt", "左": [1],           "右": 0, "期望": true},
    {"操作符": "length_lt", "左": "abc",         "右": 5, "期望": true},
    {"操作符": "length_eq", "左": {"a": 1},      "右": 1, "期望": true},
    {"操作符": "length_eq", "左": 5,             "右": 1, "期望": "类型不匹配", "为什么": "数字没有长度"},
    {"操作符": "length_eq", "左": [],            "右": true, "期望": "类型不匹配",
      "为什么": "右操作数要整数,而 True 在 Python 里是 1"}
  ],
  "日期单独一组": [
    {"操作符": "date_before", "左": "2026-01-01", "右": "2026-09-26", "期望": true},
    {"操作符": "date_after",  "左": "2026-09-26T10:00:00Z", "右": "2026-09-26", "期望": true},
    {"操作符": "date_before", "左": "2026-01-01", "右": "2026-01-01", "期望": false},
    {"操作符": "date_before", "左": "去年",        "右": "今年",        "期望": "类型不匹配",
      "为什么": "**不拿自由文本做字典序比较** —— 那种比较的结果看着像对的"},
    {"操作符": "date_before", "左": 20260101,     "右": 20260926,     "期望": "类型不匹配",
      "为什么": "数字日期要显式转换,不然 20261301 这种也能比"}
  ],
  "包含": [
    {"操作符": "contains", "左": ["甲", "乙"], "右": "甲", "期望": true},
    {"操作符": "contains", "左": ["甲"],       "右": "丙", "期望": false},
    {"操作符": "contains", "左": "甲乙丙",     "右": "乙", "期望": true},
    {"操作符": "contains", "左": "123",        "右": 2,    "期望": "类型不匹配",
      "为什么": "不把数字转成文本再找"},
    {"操作符": "contains", "左": 5,            "右": 5,    "期望": "类型不匹配"}
  ]
}
