<?xml version="1.0" encoding="UTF-8"?>
<!-- 智能运维平台 :8770 常驻(用户 2026-10-23 拍,同 com.lanxiu.backend.plist)。
     装 / 卸 / 看状态:./tools/always_on.sh install | uninstall | status
     ⚠️ 环境变量和 ./start.sh 起的一样(没设 LANXIU_PROVIDER)—— 模型走哪家不在这里改,
        常驻和手起两种方式跑出来的必须是同一个东西。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lanxiu.agentsite</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/eureka/Desktop/澜绣云裳agent/agentsite/.venv/bin/python</string>
    <string>app.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/eureka/Desktop/澜绣云裳agent/agentsite</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/tmp/lanxiu-agentsite.log</string>
  <key>StandardErrorPath</key><string>/tmp/lanxiu-agentsite.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <!-- 工作流接管(10-24):聊天站问开关、发起被接管的工作流。只连澜绣正式项目 -->
    <key>LANXIU_USAGE_URL</key><string>http://127.0.0.1:8801</string>
    <key>LANXIU_BRIDGE_PROJECT</key><string>project_lanxiu</string>
    <key>LANXIU_USAGE_USER</key><string>U001</string>
    <!-- 转人工(11-10 用户点头开):判不出 / 分类调用失败 / 路由规则点名转人工 → 建人工待办、店长看到待办编号。
         ⚠️ 和 管理后台 runtime/术语.py 的「还没接上的去向」一起动:那张表放行而这里没开 = 后台能选、聊天站不生效 -->
    <key>LANXIU_CHAT_HANDOFF</key><string>1</string>
  </dict>
</dict>
</plist>
